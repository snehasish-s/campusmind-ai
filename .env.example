# Generate local secrets with: python scripts/setup_env.py
# PostgreSQL bootstrap administrator (used only by the database container).
POSTGRES_PASSWORD=
# Separate least-privilege application login, created by infra/init-db.sh.
APP_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://campusmind_app:REPLACE_WITH_APP_DB_PASSWORD@localhost:5432/campusmind
REDIS_URL=redis://localhost:6379/0
APP_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
SESSION_HOURS=12
INVITATION_HOURS=48
STORAGE_ROOT=./data/storage
QUEUE_MODE=rq
RATE_LIMIT_BACKEND=redis
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=CampusMind <no-reply@campusmind.test>
# Frontend uses same-origin /api proxy; never exposes API credentials.
API_INTERNAL_URL=http://127.0.0.1:8000
# Phase 2: no local model is required for core workflows.
AI_MODE=fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_SECONDS=45
GRAPH_CHECKPOINT_URL=
EMBEDDING_MODE=keyword
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
STORAGE_BACKEND=local
RETENTION_DAYS=90
LANGSMITH_TRACING=false
DEPLOYMENT_MODE=local
BOOTSTRAP_TOKEN=
# Hosted credential placeholders are in .env.hosted.example.
