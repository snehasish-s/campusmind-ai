# PLACEHOLDERS ONLY. Enter these in Render's private Environment settings.
# Never prefix credentials with NEXT_PUBLIC_ or commit an edited copy.
DEPLOYMENT_MODE=render
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
GRAPH_CHECKPOINT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
APP_ORIGIN=https://YOUR_SERVICE_NAME.onrender.com
SECURE_COOKIES=true
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=INSERT_BACKEND_ONLY_SERVICE_ROLE_KEY_HERE
SUPABASE_STORAGE_BUCKET=campusmind-private
BOOTSTRAP_TOKEN=INSERT_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
QUEUE_MODE=sync
RATE_LIMIT_BACKEND=database
AI_MODE=fallback
EMBEDDING_MODE=keyword
LANGSMITH_TRACING=false
SMTP_HOST=
# Render free blocks SMTP ports. Use audited one-time invitation distribution.
